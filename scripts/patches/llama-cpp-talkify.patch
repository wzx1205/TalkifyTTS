+    // 外部声码器路径(TalkifyNPU):codes_buf [F][16] 按 25 帧块送外部声码器。
+    // 同步模式(vocoder_fn):当场解码。异步模式(submit/wait):入队即回,
+    // 解码在实现方线程上与帧生成流水线并行,PCM 由 voc_wait_upto() 按序取回。
+    bool flush_vocoder_ext() {
+        constexpr int FRAME_CODES   = 16;
+        constexpr int CHUNK_FRAMES  = 25;   // tok_decoder 定长导出
+        constexpr int SR_PER_FRAME  = 1920; // 24000Hz / 12.5fps
+        const size_t n_frames = codes_buf.size() / FRAME_CODES;
+        if (n_frames == 0) {
+            codes_buf.clear();
+            return true;
+        }
+        std::vector<float> out(CHUNK_FRAMES * SR_PER_FRAME);
+        for (size_t s = 0; s < n_frames; s += CHUNK_FRAMES) {
+            const int n = (int) std::min<size_t>(CHUNK_FRAMES, n_frames - s);
+            const double t0 = talkify_frame_prof::now_ms();
+            if (vocoder_submit_fn) {
+                if (vocoder_submit_fn(codes_buf.data() + s * FRAME_CODES, n,
+                                      voc_next_submit, vocoder_ud) != 0) {
+                    LOG_ERR("mtmd_helper_gen_audio: vocoder submit failed\n");
+                    return false;
+                }
+                voc_next_submit++;
+                voc_pending_frames.push_back(n);
+            } else if (vocoder_fn(codes_buf.data() + s * FRAME_CODES, n,
+                                  out.data(), vocoder_ud) != 0) {
+                LOG_ERR("mtmd_helper_gen_audio: external vocoder failed\n");
+                return false;
+            }
+            TFP_LOG("voc_ext chunk_frames=%d ms=%.1f", n,
+                    talkify_frame_prof::now_ms() - t0);
+            if (!vocoder_submit_fn) {
+                audio_pcm.insert(audio_pcm.end(), out.begin(), out.begin() + n * SR_PER_FRAME);
+            }
+        }
+        codes_buf.clear();
+        return true;
+    }
+
+    // 异步模式:按序取回 [voc_next_wait, upto) 的块并入 PCM
+    bool voc_wait_upto(int64_t upto) {
+        constexpr int SR_PER_FRAME = 1920;
+        if (!vocoder_wait_fn) return true;
+        std::vector<float> out(25 * SR_PER_FRAME);
+        while (voc_next_wait < upto) {
+            if (vocoder_wait_fn(voc_next_wait, out.data(), vocoder_ud) != 0) {
+                LOG_ERR("mtmd_helper_gen_audio: vocoder wait failed\n");
+                voc_pending_frames.clear();
+                return false;
+            }
+            const int n = voc_pending_frames.empty() ? 25 : voc_pending_frames.front();
+            if (!voc_pending_frames.empty()) voc_pending_frames.erase(voc_pending_frames.begin());
+            audio_pcm.insert(audio_pcm.end(), out.begin(), out.begin() + n * SR_PER_FRAME);
+            voc_next_wait++;
+        }
+        return true;
+    }
