+namespace talkify_frame_prof {
+struct Stats {
+    double gen_code_ms = 0;   // code predictor (ggml GEN_CODE)
+    double gen_wav_ms  = 0;   // vocoder windows (amortized)
+    double decode_ms   = 0;   // backbone llama_decode steps
+    int    frames      = 0;
+    void add(double code, double wav, double dec) {
+        gen_code_ms += code; gen_wav_ms += wav; decode_ms += dec; frames++;
+        if (frames % 50 == 0) {
+            TFP_LOG("n=%d avg code=%.1fms wav=%.1fms dec=%.1fms sum=%.1fms",
+                    frames, gen_code_ms / frames, gen_wav_ms / frames, decode_ms / frames,
+                    (gen_code_ms + gen_wav_ms + decode_ms) / frames);
+        }
+    }
+    void summary() {
+        if (frames > 0) {
+            TFP_LOG("SUMMARY n=%d avg code=%.1fms wav=%.1fms dec=%.1fms sum=%.1fms",
+                    frames, gen_code_ms / frames, gen_wav_ms / frames, decode_ms / frames,
+                    (gen_code_ms + gen_wav_ms + decode_ms) / frames);
+        }
+    }
+    void clear() { gen_code_ms = gen_wav_ms = decode_ms = 0; frames = 0; }
+};
+inline double now_ms() {
+    using namespace std::chrono;
+    return duration<double, std::milli>(steady_clock::now().time_since_epoch()).count();
+}
+inline Stats & stats() { static Stats s; return s; }
